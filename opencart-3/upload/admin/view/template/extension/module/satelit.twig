{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div id="satelit-alert"></div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-key">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="password" name="module_satelit_api_key" value="" autocomplete="new-password" placeholder="{{ key_saved ? '••••••••••••' : 'sat_live_…' }}" id="input-api-key" class="form-control"/>
                <span class="input-group-btn"><button type="button" id="button-test" class="btn btn-info"><i class="fa fa-plug"></i> {{ button_test }}</button></span>
              </div>
              {% if error_api_key %}<div class="text-danger">{{ error_api_key }}</div>{% endif %}
              <p class="help-block">{% if key_saved %}{{ text_key_saved }} {% endif %}{{ help_api_key }} {{ text_get_key }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-language">{{ entry_language }}</label>
            <div class="col-sm-10">
              <select name="module_satelit_language" id="input-language" class="form-control">
                {% for code, name in languages %}
                <option value="{{ code }}"{% if code == module_satelit_language %} selected="selected"{% endif %}>{{ name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <fieldset>
            <legend>{{ text_rates }}</legend>
            <p>{{ text_rates_help }} <span class="text-muted">{{ text_attribution }}</span></p>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-rates-ttl">{{ entry_rates_ttl }}</label>
              <div class="col-sm-10">
                <input type="number" min="1" max="24" name="module_satelit_rates_ttl" value="{{ module_satelit_rates_ttl|e }}" id="input-rates-ttl" class="form-control"/>
                {% if error_rates_ttl %}<div class="text-danger">{{ error_rates_ttl }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ text_last }}</label>
              <div class="col-sm-10">
                <p class="form-control-static" id="satelit-last">{{ last_log ? last_log|e : text_never }}</p>
                <button type="button" id="button-rates" class="btn btn-primary"><i class="fa fa-refresh"></i> {{ button_rates }}</button>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cron">{{ text_cron }}</label>
              <div class="col-sm-10">
                <input type="text" readonly value="{{ cron_url|e }}" id="input-cron" class="form-control" onclick="this.select()"/>
                <p class="help-block">{{ text_cron_help }}</p>
                {% if not has_engines %}
                <p class="help-block">{{ text_engine_none }}</p>
                {% elseif engine_on %}
                <p class="help-block text-success">{{ text_engine_on }}</p>
                {% else %}
                <p class="help-block">{{ text_engine_off|format(currency_link) }}</p>
                {% endif %}
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_market }}</legend>
            <p>{{ text_layout }}</p>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="module_satelit_status" id="input-status" class="form-control">
                  <option value="1"{% if module_satelit_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not module_satelit_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-prices-ttl">{{ entry_prices_ttl }}</label>
              <div class="col-sm-10">
                <input type="number" min="1" max="48" name="module_satelit_prices_ttl" value="{{ module_satelit_prices_ttl|e }}" id="input-prices-ttl" class="form-control"/>
                {% if error_prices_ttl %}<div class="text-danger">{{ error_prices_ttl }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-offers">{{ entry_offers }}</label>
              <div class="col-sm-10">
                <input type="number" min="1" max="10" name="module_satelit_offers" value="{{ module_satelit_offers|e }}" id="input-offers" class="form-control"/>
                {% if error_offers %}<div class="text-danger">{{ error_offers }}</div>{% endif %}
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
function satelitAlert(json) {
	var ok = json['success'] !== undefined;
	var box = $('<div class="alert alert-dismissible"><i class="fa"></i> <span></span> <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
	box.addClass(ok ? 'alert-success' : 'alert-danger').find('i').addClass(ok ? 'fa-check-circle' : 'fa-exclamation-circle');
	box.find('span').text(ok ? json['success'] : json['error']);
	$('#satelit-alert').html(box);
	return ok;
}
$('#button-test').on('click', function() {
	var btn = $(this);
	$.ajax({url: '{{ test }}', type: 'post', dataType: 'json', data: {key: $('#input-api-key').val()},
		beforeSend: function() { btn.button('loading'); }, complete: function() { btn.button('reset'); },
		success: satelitAlert, error: function(xhr) { satelitAlert({error: xhr.status + ' ' + xhr.statusText}); }});
});
$('#button-rates').on('click', function() {
	var btn = $(this);
	$.ajax({url: '{{ rates }}', type: 'post', dataType: 'json', data: {go: 1},
		beforeSend: function() { btn.button('loading'); }, complete: function() { btn.button('reset'); },
		success: function(json) { satelitAlert(json); $('#satelit-last').text(json['success'] || json['error']); },
		error: function(xhr) { satelitAlert({error: xhr.status + ' ' + xhr.statusText}); }});
});
//--></script>
{{ footer }}
